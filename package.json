{
  "name": "ios-app-factory",
  "version": "1.0.0",
  "description": "Agentic suite that continuously codes new iOS apps (crypto to sci-fi), tests them end-to-end in simulator/device, and ships to TestFlight.",
  "main": "tui.js",
  "scripts": {
    "bot": "node bot/telegram.js",
    "factory": "node orchestrator/run-loop.js",
    "bridge": "node openclaw/bridge.js",
    "web": "node web/server.js",
    "pipeline": "node orchestrator/pipeline.js",
    "matrix": "node orchestrator/e2e-matrix.js --slug near-fear",
    "telegram:e2e": "BOT_HEADLESS_TEST=1 BOT_E2E_DRY_RUN=1 node orchestrator/telegram-e2e.js --slug near-fear",
    "audit": "bash scripts/audit.sh",
    "setup": "node scripts/setup.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@supabase/supabase-js": "^2.98.0",
    "chokidar": "^3.6.0",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.33.0",
    "express": "^5.2.1",
    "node-telegram-bot-api": "^0.67.0",
    "puppeteer": "^25.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
