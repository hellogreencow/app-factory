# iOS App Factory — Environment Variables
# Copy this file to .env and fill in your values.
# Or run: node scripts/setup.js   (guided wizard — recommended)

# ── LLM ──────────────────────────────────────────────────────────────────────
# OpenRouter API key for LLM-powered idea generation + code agents
# Get one free at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Telegram Bot ─────────────────────────────────────────────────────────────
# Create a bot with @BotFather on Telegram, copy the token here
# This is the primary interface for building apps conversationally
TELEGRAM_BOT_TOKEN=

# ── Apple Developer ───────────────────────────────────────────────────────────
# Your Apple Developer account email
APPLE_ID=you@example.com

# Team ID — find at: developer.apple.com → Account → Membership → Team ID
EXPO_APPLE_TEAM_ID=XXXXXXXXXX

# ── App Store Connect API Key ─────────────────────────────────────────────────
# Create at: appstoreconnect.apple.com → Users & Access → Integrations → Keys
# Role: Admin (required for full access)
# Steps:
#   1. Click "+" to generate a key
#   2. Download the .p8 file (can only be downloaded once — store it safely)
#   3. Copy the Key ID and Issuer ID shown on the page
EXPO_ASC_KEY_ID=XXXXXXXXXX
EXPO_ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXPO_ASC_API_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_YOURKEYID.p8

# ── App-Specific Password ─────────────────────────────────────────────────────
# Required once to create new apps on App Store Connect interactively.
# Generate at: appleid.apple.com → Sign-In & Security → App-Specific Passwords
# Format: xxxx-xxxx-xxxx-xxxx
EXPO_APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
